PORT=3000
HOST=0.0.0.0
# Kies een eigen sterk beheerderswachtwoord (minimaal 12 tekens).
ADMIN_PASSWORD=vervang-dit-wachtwoord
# Pad naar het SQLite-bestand; runtimegegevens niet delen met spelers.
DATABASE_PATH=./data/finance.sqlite
# Stel in op true wanneer de app achter HTTPS wordt aangeboden.
COOKIE_SECURE=false
