PORT=3000
HOST=0.0.0.0
# Kies een eigen sterk beheerderswachtwoord (minimaal 12 tekens).
ADMIN_PASSWORD=vervang-dit-wachtwoord
# Pad naar het SQLite-bestand; runtimegegevens niet delen met spelers.
DATABASE_PATH=./data/finance.sqlite
# Stel in op true wanneer de app achter HTTPS wordt aangeboden.
COOKIE_SECURE=false
# Alleen online op Vercel: koppel een gratis Neon-database en stel DATABASE_URL in.
# Deze variabelen zijn servergeheimen; gebruik nooit een VITE_-prefix.
# DATABASE_URL=postgresql://...
# Optioneel bij eerste cloudinitialisatie: bestaande permanente laptopcodes als JSON.
# LAPTOP_CODES_JSON={"1":"0123","2":"1234","3":"2345","4":"3450","5":"4501","6":"5012","7":"0234","8":"1345"}
